snippet qt "" i
`!p
x = re.match(r"([EeDd\d\.\,\+\-]+)\s+(.+)", snip.v.text)
if x:
	value = x.group(1)
	unit = x.group(2)
	unit = unit.replace(r"/", r"\per")
	unit = re.sub(r"\bm\b", r"\\meter", unit)
	unit = re.sub(r"\bs\b", r"\\second", unit)
	unit = re.sub(r"\bdC\b", r"\\degreeCelsius", unit)
	unit = re.sub(r"\bW\b", r"\\watt", unit)
	unit = re.sub(r"\bV\b", r"\\volt", unit)
	unit = re.sub(r"\bA\b", r"\\ampere", unit)
	unit = re.sub(r"\bK\b", r"\\kelvin", unit)
	unit = re.sub(r"\bg\b", r"\\gram", unit)
	unit = re.sub(r"\bN\b", r"\\newton", unit)
	unit = re.sub(r"\bL\b", r"\\liter", unit)
	unit = re.sub(r"\bmol\b", r"\\mole", unit)
	unit = re.sub(r"\bml\b", r"\\mL", unit)
	unit = re.sub(r"\bJ\b", r"\\joule", unit)
	unit = re.sub(r"\bMeV\b", r"\\mega\\eV", unit)
	unit = re.sub(r"\bS\b", r"\\siemens", unit)
	unit = re.sub(r"\bF\b", r"\\farad", unit)
	unit = re.sub(r"\bH\b", r"\\henry", unit)
	unit = re.sub(r"\bC\b", r"\\coulomb", unit)
	unit = re.sub(r"\bHz\b", r"\\hertz", unit)
	unit = re.sub(r"\\Omega", r"\\ohm", unit)
	unit = re.sub(r"\\mu", r"\\micro", unit)
	unit = re.sub(r"(\w+)\^2", r"\\square\\\1", unit)
	snip.rv = rf"\qty{{{value}}}{{{unit}}}"
`$0
endsnippet

context "math()"
#snippet "\s*([\+\-]?\d+(?:[\.\,]\d+)?)\s*(?:\\times|\\cdot|\.)?\s*(10\^\{?([\d\+\-]+)\}?)?\s*([^\$\=]+)?.q" "" r
snippet "\s*([-+]?\d+(?:[.,]\d+)?)?\s*(?:\\times|\\cdot|\.|\^\{\*\}|\*)?\s*(10\^\{?([\d\+\-]+)\}?)?\s*([^\$\=]+)?.q" "" r
`!p
num = match.group(1).replace(",", ".")
if match.group(2):
	num += f"e{match.group(3)}"
if match.group(4):
	g = match.group(4)
	g = re.sub(r"\s*\\cdot\s*", " ", g)
	g = re.sub(r"\^\{\\circ\}\s*C", "degreeCelsius", g)
	g = re.sub(r"\^\{\\circ\}\s*\\mathrm\{C\}", "degreeCelsius", g)
	g = re.sub(r"\\mathrm\{(\~?(\w+))\}", r"\1", g)
	names = {1: "", 2: "\\square", 3: "\\cubic"}
	unit = ""
	for (v, e) in re.findall(r"([a-zA-Z]+)(?:\^\{(-?\d+)\})?", g):
		v = v.replace("Omega", "ohm")
		if not e:
    	    unit += "\\" + v
		if e:
    	    n = int(e)
    	    if n < 0:
    	        unit += "\\per" + names[-n] + "\\" + v
    	    else:
    	        unit += names[n] + "\\" + v
qty = f"\\qty{{{num}}}{{{unit}}}"
snip.rv = qty
`
endsnippet

context "math()"
snippet "\s*([\d\.\,\+\-]+)\s*\^\{?\\circ\}?.a" "" r
`!p
num = match.group(1).replace(",", ".")
snip.rv = f"\\ang{{{num}}}"
`
endsnippet

context "math()"
snippet "\s*([\d\.\,\+\-]+)\s*(?:\\times|\\cdot|\^\{\*\}|\*)?\s*(10\^\{?([\d\+\-]+)\}?)?.n" "" r
`!p
num = match.group(1).replace(",", ".")
if match.group(2):
	g3 = match.group(3)
	num += f"e{g3}"
snip.rv = f"\\num{{{num}}}"
`
endsnippet

