# Section label
snippet "(\\(sub)?(sub)?section{(.*?)}\s*$)" "" br
`!p snip.rv = match.group(1)`
\label{`!p
import unicodedata
s = "sec"
if match.group(2):
	s = "ssec"
if match.group(3):
	s = "sssec"
text = match.group(4).replace(" ","_")
text = unicodedata.normalize('NFKD', text).encode('ascii', 'ignore').decode('ascii')
text = re.sub(r"[^\w]","",text)
snip.rv = s+":"+text.lower()`}
endsnippet

