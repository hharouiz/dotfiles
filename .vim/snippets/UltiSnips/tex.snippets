# For mathpix
snippet f_ "" b
`!p
tex = snip.v.text
tex = re.sub(r"\[h\]", "[H]", tex)
tex = re.sub(r"(\\includegraphics)\[.+?\]", r"\1[width=.7\\textwidth]", tex)
newtex = ""
for line in tex.split("\n"):
	if "\\begin{center}" in line:
		line = "\\centering"
	if "\\end{center}" in line or "\\captionsetup" in line:
		continue
	if not "{figure}" in line:
		line = "\t"+line.strip()
	newtex += line+"\n"
snip.rv = newtex
`
endsnippet

snippet tab_ "" b
`!p
tex = snip.v.text
tex = tex.replace("{tabular}", "{tabularx}")
tex = tex.replace("{table}[h]", "{table}[H]")
tex = re.sub(r"(\\begin{tabularx})(?:\[[tbc]\])?\{([\|lcr]+)\}", lambda m: m.group(1)+r"{\textwidth}{"+m.group(2).upper()+"}", tex)
newtex = ""
for line in tex.split("\n"):
	if "\\begin{center}" in line:
		line = "\\centering"
	if "\\end{center}" in line or "\\captionsetup" in line:
		continue
	if not "{table}"  in line:
		line = "\t"+line.strip()
	newtex += line+"\n"

result = ""
indent = 0
for line in newtex.split("\n"):
    line = line.strip()

    if r"\end{tabularx}" in line:
        indent -= 1

    if r"\end{table}" in line:
        indent -= 1

    result += "\t" * indent + line + "\n"

    if r"\begin{table}" in line:
        indent += 1

    if r"\begin{tabularx}" in line:
        indent += 1

newtex = result.rstrip()

if not "{table}" in newtex:
	newtex = r"""
\begin{table}[H]
\centering
%s
\end{table}
""" %  newtex.strip()
snip.rv = newtex
`
endsnippet
