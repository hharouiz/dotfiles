\if@myds
    \newcommand\D[1]{\gdef\@D{#1}}
    \newcommand\dn[1]{\gdef\d@n{#1}}
    \newcommand\classe[1]{\gdef\@classe{#1}}
    \newcommand\annee[1]{\gdef\@annee{#1}}
    \newcommand\semestre[1]{\gdef\@semestre{#1}}
    \newcommand\duree[1]{\gdef\@duree{#1}}
    \newcommand\lycee[1]{\gdef\@lycee{#1}}
    \newcommand\matiere[1]{\gdef\@matiere{#1}}
    \renewcommand*\maketitle{%
        \tcbset{before=,after=\hfill,
            colframe=blue!75!black,colback=white, colback=white, colframe=black,
            boxrule=0.8pt, arc=0pt, outer arc=0pt, top=2mm,
            bottom=2mm,right=1mm,left=1mm}
        \if\@D S
            \gdef\@devoir{Surveillé}
        \fi
        \if\@D M
            \gdef\@devoir{à maison}
        \fi
        \if@bac
            \begin{tcbitemize}[raster columns=3,raster equal height=rows,
                raster force size=false,raster column skip=2pt,
                raster column 1/.style={add to width=1.2cm},
                raster column 2/.style={add to width=0cm,halign=center},
                raster column 3/.style={add to width=-1.2cm},
                ]
                \tcbitem
                    {\bfseries Lycée~:} \@lycee \\[2mm]
                    {\bfseries Matière~:} \@matiere
                \tcbitem
                    \if@correction
                        {\large\bfseries Correction du D\@D{} N$^{\circ}\d@n$}
                    \else
                        {\large\bfseries Devoir \@devoir{} N$^{\circ}$\d@n}
                    \fi\\[2mm]
                    {\large\bfseries Semestre~\@semestre}
                \tcbitem
                    {\bfseries Classe~:} \@classe \\[2mm]
                    {\bfseries Année~:} \@annee
            \end{tcbitemize}
        \else
            \begin{tcbitemize}[raster columns=4,raster equal height=rows,
                raster force size=false,raster column skip=2pt,
                raster column 1/.style={add to width=1.5cm},
                raster column 2/.style={add to width=1.5cm,halign=center},
                raster column 3/.style={add to width=0cm},
                raster column 4/.style={add to width=-3cm},
                ]
                \tcbitem
                    {\bfseries Prénom~:} \dotfill \\[2mm]
                    {\bfseries Nom~:} \dotfill \\[2mm]
                    {\bfseries N$^{\circ}$~:} \dotfill
                \tcbitem
                    \if@correction
                        {\large\bfseries Correction du D\@D{} N$^{\circ}\d@n$}
                    \else
                        {\large\bfseries Devoir \@devoir{} N$^{\circ}$\d@n}
                    \fi \\[2mm]
                    {\large\bfseries Physique-Chimie} \\[2mm]
                    {\large\bfseries Semestre~\@semestre}
                \tcbitem
                    {\bfseries Classe~:} \@classe \\[2mm]
                    {\bfseries Année~:} \@annee
                \tcbitem
                    {\Large $$\frac{}{\; \mathbf{20}\;}$$ }
            \end{tcbitemize}
        \fi
    }
\fi

