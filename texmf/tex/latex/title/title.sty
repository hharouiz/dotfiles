    \newcommand\institute[1]{\gdef\@institute{#1}}
    \renewcommand*\maketitle{\begin{titlepage}%
        %\TitlePageGeometry
        %%% Lengths
        \newlength{\TitlePageHeadWidth}
        \setlength{\TitlePageHeadWidth}{1in+\topmargin}
        \newlength{\TitlePageFootWidth}
        \setlength{\TitlePageFootWidth}
            {\paperheight-1in-\topmargin-\headheight-\headsep-\textheight}
        \newlength{\TitlePageInnerWidth}
        \setlength{\TitlePageInnerWidth}{1in+\oddsidemargin}
        \newlength{\TitlePageOuterWidth}
        \setlength{\TitlePageOuterWidth}
            {\paperwidth-1in-\oddsidemargin-\textwidth}
        \newdimen\@titlewidth
        \begin{tikzpicture}[overlay,remember picture]
            %\coordinate (center) at (0,0);
            %\coordinate (top) at (0,.51\paperheight);
            %\coordinate (bottom) at (0,-.51\paperheight);
            %\coordinate (left) at (-.51\paperwidth,0);
            %\coordinate (right) at (.51\paperwidth,0);
            %\draw[<->] (current page.west) -- ++(\leftmargin,0)
            %    node[right] {\tt\string\leftmargin=\the\leftmargin};
            %\draw[<->] ([yshift=-1cm]current page.west) -- ++(1in+\hoffset,0)
            %    node[right] {\tt1in+\string\hoffset=1in+\the\hoffset};
            %\draw[<->] ([yshift=-2.2cm]current page.north west) -- ++(20mm,0)
            %    node[pos=.5,above] {\tt inner};
            %\draw[<->] ([yshift=-2.2cm]current page.north east) -- ++(-20mm,0)
            %    node[pos=.5,above] {\tt outer};
            \node[fill=tertiarycolor,anchor=north west,inner sep=0pt,
                  minimum width=\paperwidth,minimum height=\paperheight] (paper)
                at ([xshift=-.2pt,yshift=.2pt]current page.north west) {};
            \node[fill=primarycolor,anchor=north west,inner sep=0pt,
                  minimum width=\paperwidth,minimum height=11cm]
                (rec) at (paper.north west) {};
            % Title Box
	        \node[align=flush left,inner sep=0mm,anchor=south west,
                  font=\fontsize{1.5cm}{1.3cm}\selectfont\TitleFont,
                  text=TitleColor] (title) at
                ([xshift=\TitlePageInnerWidth,yshift=7cm]paper.west)
                {%
                    \begin{varwidth}{\textwidth}
                        \narrowragged  % from varwidth package
                        \hyphenpenalty10000\exhyphenpenalty10000
                        \righthyphenmin62\lefthyphenmin62
                        \@title
                    \end{varwidth}
                };
            % Rule
            \getwidthofnode{\@titlewidth}{title}
            \node[fill=tertiarycolor,inner sep=0pt,
                  minimum size=\@titlewidth,minimum height=5pt,
                  below=4mm of title] (rule) {};
            % Subtitle Box
	        \node[align=flush left,inner sep=0mm,anchor=north west,
                  font=\bfseries\LARGE\sffamily,text=tertiarycolor]
                (doctype) at ([yshift=-4mm]rule.south west)
                {%
                    \begin{varwidth}{\textwidth}
                        \narrowragged  % from varwidth package
                        \hyphenpenalty10000\exhyphenpenalty10000
                        \righthyphenmin62\lefthyphenmin62
                        \@subject
                    \end{varwidth}
                };
            % Doctype (circular shape)
            \node[circle,fill=secondarycolor,inner sep=2mm,
                  minimum size=2cm,font=\DoctypeFont\LARGE,
                  align=center,anchor=east,text=tertiarycolor,
                  circular glow={fill=black,opacity=0.5}]
                at ([xshift=-\TitlePageOuterWidth]rec.south east) {\@doctype};
            % Author
	        \node[align=flush left,inner sep=0mm,anchor=north west,
                  font=\AuthorFont\Huge,text width=\textwidth,
                  text=secondarycolor]
                (author) at
                ([xshift=\TitlePageInnerWidth,yshift=-2cm]rec.south west)
                {\@author};
            % Institute
	        \node[align=flush left,inner sep=0mm,anchor=north west,
                  font=\InstituteFont\Huge,text width=\textwidth,
                  text=secondarycolor]
                (institute) at ([yshift=-1cm]author.south west) {\@institute};
            % Date
	        %\node[align=flush left,inner sep=0mm,anchor=north west,
            %      font=\fontsize{1.5cm}{1.3cm}\DateFont,text width=\textwidth,
            %      text=primarycolor]
            %    (institute) at ([yshift=-2cm]institute.south west) {\@date};
            \node[align=flush left,anchor=south west,inner sep=0pt,
                font=\fontsize{1.2cm}{1.1cm}\selectfont\DateFont,
                text=primarycolor,
                xshift=\TitlePageInnerWidth,yshift=\TitlePageFootWidth] at
                (paper.south west) {\@date};
            % Logo
            \node[anchor=south east,inner sep=0pt,
                xshift=-\TitlePageOuterWidth,yshift=\TitlePageFootWidth] at
                (paper.south east) {\includesvg{g6768}};
            % 
            %\node[fill=primarycolor,anchor=south west,inner sep=0pt,
            %      minimum width=\paperwidth,minimum height=8mm] (brec)
            %    at ([xshift=-.2pt,yshift=-.2pt]current page.south west) {};
	        %\node[align=flush left, inner sep=0mm, anchor=west,
            %      font=\large,text width=\textwidth,text=primarycolor!0.8]
            %    (logo) at ([xshift=3mm]brec.west) {\LyDeX};
	        %\node[align=flush right, inner sep=0mm, anchor=east,
            %      font=\large,text width=\textwidth,text=white]
            %    (date) at ([xshift=-3mm]brec.east) {\@date};
        \end{tikzpicture}
        %\restoregeometry
    \end{titlepage}}

\fi

