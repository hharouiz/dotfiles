\newcommand\TitlePageGeometry{%
    \newgeometry{%
        top=20mm,
        bottom=20mm,
        inner=20mm,
        outer=20mm,
        headsep=10mm,
        footskip=10mm,
        includehead,
        ignorefoot,
        nomarginpar
    }
}
\if@teaching
    \def\LyDeX{L\kern-.2em\lower.5ex\hbox{Y}\kern-.06em D\lower.5ex\hbox{E}\kern-.06em X}
