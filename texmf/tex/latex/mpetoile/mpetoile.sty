% Python Code
\NewTCBInputListing[]{\PrintPython}{ O{} m m }{
    listing file={#2},
    listing engine=minted,
    minted language=python,
    minted options={fontsize=\scriptsize,linenos,numbersep=3mm},
    boxrule=1.0pt,boxsep=1mm,left=6mm,right=5mm,top=0mm,bottom=0mm,middle=0mm,
    colback=ManniBackgroundColor,colframe=PythonBlueColor,
    %colbacktitle=PythonYellowColor,
    fonttitle=\bfseries\large,coltitle=PythonBlueColor,
    listing only,title=Python,
    listing and comment,tcbimage comment={#3},
    comment style={enhanced,size=minimal,empty},
    lower separated=false,sharp corners,
    enhanced,
    title code={%
        \fill[PythonYellowColor]
            (title.north west) rectangle (title.south east);
        %\fill[PythonBlueColor] (title.north east) rectangle (title.south);
        \node[anchor=west,inner sep=0pt] at ([xshift=0.7mm]title.west)
            {\includesvg{g18.svg}};
    },
    overlay={%
        \begin{tcbclipinterior}
        \draw[gray40,thick,line cap=round]
            ([xshift=5.5mm,yshift=-1mm]interior.north west) coordinate (tmp) --
            ([yshift=1mm]tmp |- segmentation.north);
            %\fill[red] (segmentation.center) circle (1pt);
            %\draw[red] (interior.north east) rectangle (interior.south west);
        \end{tcbclipinterior}
    },
    watermark text={\includesvg{PythonLogo32x32BW.svg}},watermark opacity=0.05,
    %draft,
    #1
}


