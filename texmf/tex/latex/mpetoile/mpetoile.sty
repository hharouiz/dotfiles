% Background
\DeclareRobustCommand*{\sidelogo}[1]{\gdef\@sidelogo{#1}}
\DeclareRobustCommand*{\sidetext}[1]{\gdef\@sidetext{#1}}
\DeclareRobustCommand*{\sidesubtext}[1]{\gdef\@sidesubtext{#1}}
\newcommand\makesidebackground{%
    \newlength{\BackgroundBandWidth}
    \setlength{\BackgroundBandWidth}{1in+\oddsidemargin-5mm}
    \newlength{\FootWidth}
    \setlength{\FootWidth}{\paperheight-1in-\topmargin-\headheight-\headsep-\textheight}
    \newlength{\InnerWidth}
    \setlength{\InnerWidth}{1in+\oddsidemargin}
    \backgroundsetup{pages=all,angle=0,opacity=1,scale=1,contents={%
        \begin{tikzpicture}[remember picture, overlay]
            \coordinate[xshift=-0.5\paperwidth,yshift=0.5\paperheight]
                (PageNorthWest) at (0,0);
            \node[fill=PageBackgroundColor,anchor=north west,inner sep=0pt,
                  minimum width=\paperwidth,minimum height=\paperheight,
                  xshift=-0.2pt,yshift=0.2pt
                  ] at (PageNorthWest) {};
            \node[fill=primarycolor,anchor=north west,inner sep=0pt,
                minimum height=\paperheight,minimum width=\BackgroundBandWidth,
                xshift=-0.2pt,yshift=0.2pt
                ] (Band) at (PageNorthWest) {};
            \node[above=\FootWidth] (logo) at (Band.south) {\@sidelogo};
            \node[fill=white,opacity=0.5,inner sep=0pt,
                minimum size=\BackgroundBandWidth+0.05pt,minimum height=5pt,
                above=8mm of logo] (rule) {};
            \node[anchor=west,
                font=\fontsize{1.5cm}{1.5cm}\selectfont\SideTextFont,
                yshift=8mm,text=white,rotate=90] (sidetext) at (rule.north)
                {\@sidetext};
            \node[above right=4pt and 9pt,font=\bfseries\scshape,
                text=secondarycolor,rotate=90,
                opacity=0.7] at (sidetext.north west) {\@sidesubtext};
        \end{tikzpicture}
}}}


% Boxes
\NewTColorBox{SimpleBox}{ O{blue} !O{} }{%
    enhanced,colframe=#1,colback=tertiarycolor!95!black,
    sharp corners,drop fuzzy shadow,#2}

\NewTColorBox{test}{ !O{} }
    {enhanced,colframe=black!30,colback=black!10,sharp corners,boxrule=5mm,
    title=Title,colbacktitle=black!10,coltitle=black,
    frame code={
        \draw[red,line width=2mm]
            (frame.north west) rectangle (frame.south east);
        \draw[red,line width=2mm]
            (frame.north west) -- (frame.south east);
    },
    interior titled code={
        \draw[blue,line width=2mm]
            (interior.north west) rectangle (interior.south east);
        \draw[blue,line width=2mm]
            (interior.north west) -- (interior.south east);
    },
    title code={
        \draw[green,line width=2mm]
            (title.north west) rectangle (title.south east);
        \draw[green,line width=2mm]
            (title.north west) -- (title.south east);
    },
    show bounding box,
    #1}

\NewTColorBox{Info}{ !O{} }{%
